[Desktop Entry]
Type=Application
Name=AppAttic
Comment=Leftovers, stale apps, unused packages, and disk usage
Exec=appattic-qt
Icon=appattic
# Utility is the one main category: a second one puts the app in two menu
# sections at once. Filesystem is the additional category that says what it
# touches. The AppStream categories in the metainfo are a separate list.
Categories=Utility;Filesystem;
Keywords=cleanup;leftover;stale;disk;usage;packages;
Terminal=false
# main.cpp calls setDesktopFileName("org.appattic.AppAttic"), and Qt derives
# WM_CLASS from that name when it is set, not from the executable. So the
# window reports WM_CLASS=org.appattic.AppAttic on X11, and a StartupWMClass
# of appattic-qt matched nothing: the panel grouped the window under a
# launcher that is not there, so the taskbar entry had no icon and no
# grouping. The name has to be the desktop file's own basename.
StartupWMClass=org.appattic.AppAttic
