[Desktop Entry]
Type=Application
Name=AppAttic
Comment=Leftovers, stale apps, unused packages, and disk usage
Exec=appattic-qt
Icon=appattic
# Utility is the one main category: a second one puts the app in two menu
# sections at once. Filesystem is the additional category that says what it
# touches. The AppStream categories in the metainfo are a separate list.
Categories=Utility;Filesystem;
Keywords=cleanup;leftover;stale;disk;usage;packages;
Terminal=false
StartupWMClass=appattic-qt
