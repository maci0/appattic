{
  "id": "path-application-support",
  "url": "path_application_support.wasm",
  "inject": [
    "host.exec",
    "host.fs",
    "appattic.plugin-abi"
  ],
  "provide": [
    "appattic.findings.path-application-support",
    "appattic.script.path-application-support",
    "appattic.dialog.path-application-support"
  ],
  "isolate": {},
  "intercept": {
    "host.exec": {
      "allow": [
        "ls"
      ],
      "denySubstrings": [
        "rm -rf",
        "rm /usr/bin"
      ]
    }
  },
  "config": {
    "root": "~/Library/Application Support"
  },
  "disabled": false
}
