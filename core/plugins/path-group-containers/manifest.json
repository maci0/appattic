{
  "id": "path-group-containers",
  "url": "path_group_containers.wasm",
  "inject": [
    "host.exec",
    "host.fs",
    "appattic.plugin-abi"
  ],
  "provide": [
    "appattic.findings.path-group-containers",
    "appattic.script.path-group-containers",
    "appattic.dialog.path-group-containers"
  ],
  "isolate": {},
  "intercept": {
    "host.exec": {
      "allow": [
        "ls"
      ],
      "denySubstrings": [
        "rm -rf",
        "rm /usr/bin"
      ]
    }
  },
  "config": {
    "root": "~/Library/Group Containers"
  },
  "disabled": false
}
