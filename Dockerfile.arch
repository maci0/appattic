FROM archlinux:base-devel
ARG SOURCE_DATE_EPOCH=0
ENV LC_ALL=C
ENV LANG=C
ENV TZ=UTC
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

LABEL org.opencontainers.image.title="AppAttic" \
      org.opencontainers.image.description="Build image for AppAttic on Arch: installs Qt 6 and links the Qt window." \
      org.opencontainers.image.source="https://github.com/maci0/appattic" \
      org.opencontainers.image.url="https://github.com/maci0/appattic" \
      org.opencontainers.image.licenses="LicenseRef-proprietary"

# Qt 6, cmake, ninja, pkgconf, clang, curl, xz and zig come from
# linux-deps.sh --install below; this line only adds what it does not install.
RUN pacman -Syu --noconfirm --needed \
        git gcc binutils libxml2 ncurses python \
    && pacman -Scc --noconfirm

# Same set Dockerfile copies, and for the same reason: linux-deps.sh sources
# every find-*.sh helper at startup and the find-*.sh pair reads the two
# version files through $ROOT while being sourced, so an incomplete COPY fails
# the RUN below before it installs anything.
COPY scripts/linux-deps.sh \
     scripts/verify-sha256.sh \
     scripts/find-zig.sh \
     scripts/find-wasmtime.sh \
     scripts/find-swift.sh \
     scripts/find-qt6.sh \
     scripts/dep-checksums.sha256 \
     /tmp/appattic/scripts/
COPY .zig-version .swift-version /tmp/appattic/
RUN bash /tmp/appattic/scripts/linux-deps.sh --install \
    && bash /tmp/appattic/scripts/linux-deps.sh --install-wasmtime \
    && rm -rf /tmp/appattic
ENV WASMTIME_DIR=/opt/wasmtime-c-api

WORKDIR /src
COPY . .
# The same build-output prune the Ubuntu image does, and for the same reason:
# .dockerignore keeps these out of the build context, and this rm covers a
# context that arrived some other way. A stale core/out/*.wasm is the file the
# WASM gate would load instead of the one this build produced.
RUN rm -rf .build .swiftpm .zig-cache .zig-cache-local core/out dist \
        ui/linux-qt/build ui/linux-qt/build-release
# AppAttic Qt 6 link is proven by scripts/linux-qt-link.sh (ldd libQt6Widgets + --smoke).
RUN pkg-config --exists Qt6Widgets \
    && pkg-config --modversion Qt6Widgets \
    && bash scripts/linux-qt-link.sh \
    && bash scripts/verify-qt-link.sh
