FROM archlinux:base-devel
ARG SOURCE_DATE_EPOCH=0
ENV LC_ALL=C
ENV LANG=C
ENV TZ=UTC
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# Qt 6, cmake, ninja, pkgconf, clang, curl, xz and zig come from
# linux-deps.sh --install below; this line only adds what it does not install.
RUN pacman -Syu --noconfirm --needed \
        git gcc binutils libxml2 ncurses python \
    && pacman -Scc --noconfirm

COPY scripts/linux-deps.sh \
     scripts/verify-sha256.sh \
     scripts/dep-checksums.sha256 \
     /tmp/appattic/scripts/
RUN bash /tmp/appattic/scripts/linux-deps.sh --install \
    && bash /tmp/appattic/scripts/linux-deps.sh --install-wasmtime
ENV WASMTIME_DIR=/opt/wasmtime-c-api

WORKDIR /src
COPY . .
# AppAttic Qt 6 link is proven by scripts/linux-qt-link.sh (ldd libQt6Widgets + --smoke).
RUN pkg-config --exists Qt6Widgets \
    && pkg-config --modversion Qt6Widgets \
    && bash scripts/linux-qt-link.sh \
    && bash scripts/verify-qt-link.sh
